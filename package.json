{
  "name": "eco-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "tools/*"],
  "scripts": {
    "shopify": "shopify",
    "shopify:products": "npm run products --workspace @moon/shopify-tools --",
    "shopify:create-product": "npm run create-product --workspace @moon/shopify-tools --",
    "crawl:products": "npm run crawl --workspace @moon/product-importer --",
    "normalize:products": "npm run normalize --workspace @moon/product-importer --",
    "import:products": "npm run import --workspace @moon/product-importer --",
    "link-product-colors": "npm run link-colors --workspace @moon/product-importer --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@shopify/cli": "latest"
  },
  "engines": {
    "node": ">=22.12"
  }
}
